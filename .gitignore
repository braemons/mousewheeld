/target
/dist
# `make dev` puts a zone-set store here rather than in /var/lib.
/dev/store
/dist

# tools/protogen is its own crate outside the workspace, so it builds into its
# own target directory; the root /target pattern is anchored and misses it.
tools/protogen/target/

# The browser client's build step. `gen/` is an intermediate — the artifact is
# the bundle at client/web/elements/daemon_api_client.js, which IS committed.
client/web/node_modules/
client/web/gen/

# The Python client. The generated stubs under mousewheeld/_proto/ ARE
# committed — an install needs no protoc — so only the build output goes here.
client/python/.venv/
client/python/dist/
client/python/.pytest_cache/
client/python/build/
__pycache__/
*.egg-info/
